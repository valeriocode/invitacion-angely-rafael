<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Angely &amp; Rafael | Celebraci&oacute;n de Compromiso</title>
  
  <!-- Vista previa para WhatsApp -->
  <meta property="og:title" content="Angely &amp; Rafael &mdash; &iexcl;Nos dijimos S&iacute;!">
  <meta property="og:description" content="Acomp&aacute;&ntilde;anos a celebrar nuestro compromiso el 14 de Noviembre de 2026.">
  <meta property="og:type" content="website">

  <!-- Fuentes & Iconos -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@400;600&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <style>
    :root {
      --bg-cream: #f4efea;
      --card-bg: #FAF7F2;
      --text-dark: #23201D;
      --text-muted: #58534C;
      --accent-gold: #b39b7d;
      --border-soft: rgba(179, 155, 125, 0.35);
      --shadow-card: 0 16px 36px rgba(0, 0, 0, 0.08), 0 2px 6px rgba(0, 0, 0, 0.04);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-cream);
      background-image: radial-gradient(#dcd5c9 0.75px, transparent 0.75px);
      background-size: 20px 20px;
      font-family: 'Cormorant Garamond', serif;
      color: var(--text-dark);
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 20px 14px 40px;
    }

    .nav-container {
      display: flex;
      gap: 6px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(8px);
      padding: 5px;
      border-radius: 30px;
      border: 1px solid var(--border-soft);
      margin-bottom: 18px;
      max-width: 440px;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-container::-webkit-scrollbar { display: none; }

    .nav-tab {
      flex: 1;
      min-width: fit-content;
      background: transparent;
      border: none;
      padding: 8px 12px;
      border-radius: 20px;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.4px;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }

    .nav-tab.active {
      background: var(--text-dark);
      color: #FFF;
    }

    .card-wrapper {
      position: relative;
      width: 100%;
      max-width: 420px;
      min-height: 600px;
    }

    .card-view {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      min-height: 600px;
      background: var(--card-bg);
      border: 1px solid var(--border-soft);
      border-radius: 18px;
      box-shadow: var(--shadow-card);
      padding: 36px 24px;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px) scale(0.98);
      transition: all 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .card-view.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }

    .card-view::before {
      content: "";
      position: absolute;
      inset: 10px;
      border: 1px dashed rgba(179, 155, 125, 0.45);
      border-radius: 12px;
      pointer-events: none;
    }

    .title-script { font-size: 1.8rem; font-style: italic; }
    .names { font-family: 'Alex Brush', cursive; font-size: 3rem; margin: 8px 0 12px; line-height: 1.1; }
    .monogram { font-family: 'Alex Brush', cursive; font-size: 3.4rem; color: var(--accent-gold); line-height: 1; }
    .monogram-sub { font-family: 'Cinzel', serif; font-size: 0.95rem; letter-spacing: 2px; color: var(--text-muted); margin-bottom: 25px; }

    .date-badge {
      font-family: 'Cinzel', serif;
      font-size: 1.75rem;
      letter-spacing: 3px;
      line-height: 1.4;
      margin: 14px 0;
    }
    .date-badge .dot { color: var(--accent-gold); font-size: 1.1rem; display: block; }

    .body-desc { font-size: 1.15rem; font-style: italic; line-height: 1.5; color: var(--text-muted); }

    .venue-title { font-size: 1.35rem; font-weight: 600; font-style: italic; margin-top: 10px; }
    .venue-addr { font-size: 1rem; color: var(--text-muted); margin: 2px 0; }
    .venue-time { font-size: 1.1rem; font-weight: 600; color: var(--accent-gold); }

    .menu-heading { font-family: 'Alex Brush', cursive; font-size: 3.6rem; margin-bottom: 6px; }
    .menu-section { font-size: 2rem; font-style: italic; margin: 16px 0 8px; color: var(--text-dark); position: relative; }
    .menu-section::after { content: ""; display: block; width: 35px; height: 1px; background: var(--accent-gold); margin: 4px auto 0; }
    .menu-item { font-size: 1.18rem; font-style: italic; color: var(--text-muted); margin: 4px 0; }

    .countdown-box {
      width: 100%;
      max-width: 420px;
      margin-top: 24px;
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid var(--border-soft);
      border-radius: 16px;
      padding: 16px;
      text-align: center;
    }

    .countdown-title {
      font-family: 'Montserrat', sans-serif;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--text-muted);
      margin-bottom: 12px;
    }

    .timer-grid {
      display: flex;
      justify-content: center;
      gap: 10px;
    }

    .timer-col {
      background: #FFF;
      border: 1px solid rgba(179, 155, 125, 0.25);
      border-radius: 10px;
      padding: 8px 10px;
      min-width: 68px;
    }

    .timer-val { font-family: 'Cinzel', serif; font-size: 1.35rem; font-weight: 600; }
    .timer-lbl { font-family: 'Montserrat', sans-serif; font-size: 0.6rem; text-transform: uppercase; color: var(--accent-gold); }

    .actions-box {
      width: 100%;
      max-width: 420px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 14px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      border-radius: 25px;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.3s;
      border: 1px solid var(--accent-gold);
    }

    .btn-dark { background: #23201D; color: #FFF; border-color: #23201D; }
    .btn-light { background: #FFF; color: var(--text-dark); }
  </style>
</head>
<body>

  <!-- Navegaci&oacute;n 4 Vistas -->
  <nav class="nav-container">
    <button class="nav-tab active" onclick="showTab(0)"><i class="fa-regular fa-envelope"></i> Invitaci&oacute;n</button>
    <button class="nav-tab" onclick="showTab(1)"><i class="fa-solid fa-utensils"></i> Men&uacute;</button>
    <button class="nav-tab" onclick="showTab(2)"><i class="fa-regular fa-face-smile"></i> Mensaje</button>
    <button class="nav-tab" onclick="showTab(3)"><i class="fa-regular fa-star"></i> Gratitud</button>
  </nav>

  <!-- Tarjetas -->
  <div class="card-wrapper">

    <!-- 1. Invitaci&oacute;n -->
    <div class="card-view active" id="view-0">
      <div>
        <div class="title-script">Nos dijimos Si!</div>
        <div class="date-badge">
          14
          <span class="dot">&bull;</span>
          11
          <span class="dot">&bull;</span>
          26
        </div>
        <div class="names">Angely &amp; Rafael</div>
        <div class="body-desc">&iexcl;Con mucha ilusi&oacute;n celebramos nuestro compromiso!</div>
        <div class="venue-title">Restaurante Loretta Caf&eacute; Bistro</div>
        <div class="venue-addr">Calle V&iacute;ctor Garrido Puello, no. 16, Santo Domingo</div>
        <div class="venue-time">7:00 pm</div>
      </div>
      <div class="body-desc" style="font-size: 1.1rem; margin-top: 15px;">
        &ldquo;Dos son mejor que uno.&rdquo;<br><small style="font-size: 0.85rem;">ECLESIAST&Eacute;S 4:9</small>
      </div>
    </div>

    <!-- 2. Men&uacute; -->
    <div class="card-view" id="view-1">
      <div>
        <div class="menu-heading">Men&uacute;</div>
        <div class="menu-section">Entradas</div>
        <div class="menu-item">Hummus Turco</div>
        <div class="menu-item">Dip de Espinacas</div>
        <div class="menu-item">Berenjena al Horno</div>
        <div class="menu-item">Burrata Marinara</div>

        <div class="menu-section">Platos Principales</div>
        <div class="menu-item">Pechuga Rellena de Goat Cheese</div>
        <div class="menu-item">Fusi&oacute;n Salm&oacute;n Plate</div>
        <div class="menu-item">Churrasco Angus al Grill</div>
        <div class="menu-item">Goat Cheese Tamarindo Salad</div>
      </div>
      <div class="title-script" style="font-size: 2rem; margin-top: 15px;">&iexcl;Buen provecho!</div>
    </div>

    <!-- 3. Mensaje Divertido -->
    <div class="card-view" id="view-2">
      <div>
        <div class="title-script" style="font-size: 2rem;">&iexcl;Gracias por venir a celebrar con nosotros!</div>
        <div class="body-desc" style="margin: 25px 0 15px;">Por acompa&ntilde;arnos, brindar, comer rico y ser testigos oficiales de que...</div>
        <div class="title-script" style="font-size: 2.2rem; font-weight: 600;">&iexcl;Si dijimos que s&iacute;!</div>
        <div class="body-desc" style="margin: 20px 0;">Nos llevamos una noche llena de amor, risas y recuerdos...<br><br><strong>Aunque en la pr&oacute;xima, &iexcl;Invitan ustedes!</strong></div>
      </div>
      <div>
        <div style="font-size: 1.2rem; font-style: italic;">Con amor,</div>
        <div class="names" style="margin-top: 0;">Angely &amp; Rafael</div>
      </div>
    </div>

    <!-- 4. Monograma / Gratitud -->
    <div class="card-view" id="view-3">
      <div>
        <div class="monogram">A&amp;R</div>
        <div class="monogram-sub">14 &bull; 11 &bull; 26</div>
        <div class="title-script" style="font-size: 2.3rem; line-height: 1.35; margin: 30px 0 20px;">
          &iexcl;Gracias por compartir esta noche inolvidable con nosotros!
        </div>
        <div class="body-desc" style="font-size: 1.3rem; margin-top: 20px;">Con gratitud eterna,</div>
        <div class="names" style="font-size: 3.2rem; margin-top: 10px;">Angely &amp; Rafael</div>
      </div>
      <div style="font-style: italic; color: var(--accent-gold);">&mdash; Santo Domingo, R.D. &mdash;</div>
    </div>

  </div>

  <!-- Contador Din&aacute;mico -->
  <div class="countdown-box">
    <div class="countdown-title"><i class="fa-regular fa-clock"></i> Cuenta regresiva para el gran d&iacute;a</div>
    <div class="timer-grid">
      <div class="timer-col"><div class="timer-val" id="days">00</div><div class="timer-lbl">D&iacute;as</div></div>
      <div class="timer-col"><div class="timer-val" id="hours">00</div><div class="timer-lbl">Horas</div></div>
      <div class="timer-col"><div class="timer-val" id="minutes">00</div><div class="timer-lbl">Minutos</div></div>
      <div class="timer-col"><div class="timer-val" id="seconds">00</div><div class="timer-lbl">Segundos</div></div>
    </div>
  </div>

  <!-- Botones de Acci&oacute;n -->
  <div class="actions-box">
    <a href="https://api.whatsapp.com/send?phone=18293426215&text=%C2%A1Hola!%20Confirmo%20con%20mucha%20alegr%C3%ADa%20mi%20asistencia%20al%20compromiso%20de%20Angely%20y%20Rafael." target="_blank" class="btn btn-dark">
      <i class="fa-brands fa-whatsapp"></i> Confirmar Asistencia (RSVP)
    </a>
    <a href="https://maps.google.com/?q=Loretta+Cafe+Bistro+Santo+Domingo" target="_blank" class="btn btn-light">
      <i class="fa-solid fa-location-dot"></i> Ver Ubicaci&oacute;n en Maps
    </a>
  </div>

  <script>
    function showTab(index) {
      document.querySelectorAll('.card-view').forEach((c, i) => c.classList.toggle('active', i === index));
      document.querySelectorAll('.nav-tab').forEach((b, i) => b.classList.toggle('active', i === index));
    }

    const targetDate = new Date('November 14, 2026 19:00:00 AST').getTime();
    function updateCountdown() {
      const now = new Date().getTime();
      const diff = targetDate - now;
      if (diff > 0) {
        document.getElementById('days').innerText = String(Math.floor(diff / (1000 * 60 * 60 * 24))).padStart(2, '0');
        document.getElementById('hours').innerText = String(Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
        document.getElementById('minutes').innerText = String(Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
        document.getElementById('seconds').innerText = String(Math.floor((diff % (1000)) / 1000)).padStart(2, '0');
      }
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();
  </script>
</body>
</html>
